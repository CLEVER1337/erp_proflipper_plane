# Plane API — ERP deploy env template (api-only). ТОЛЬКО DB-блок остаётся в env
# (как у остальных ERP-сервисов). Весь остальной конфиг — в erp_config.json
# (см. erp_config.example.json), который settings/common.py грузит в окружение.
# Реальный env перекрывает JSON (setdefault), так что при желании любой ключ можно
# переопределить здесь.
#
# Запуск:
#   docker run -d --name plane-api --network host --restart unless-stopped \
#     --env-file .env \
#     -v /path/to/erp_config.json:/code/erp_config.json:ro \
#     erp-plane-api:latest
# (или без монтирования: ERP_CONFIG_JSON=<путь> в env)

# --- Database: shared ERP Postgres, dedicated DB erp_plane (ERP-style DB_*) ---
DB_HOST=91.239.207.231
DB_PORT=18591
DB_USER=acrelis
DB_PASSWORD=<erp-pg-password>
DB_NAME=erp_plane

# --- Опционально: путь к JSON-конфигу (по умолчанию /code/erp_config.json) ---
# ERP_CONFIG_JSON=/code/erp_config.json

# --- Redis: НЕ здесь и не в JSON. Захардкожен в settings/common.py
#     (redis://:gavno@127.0.0.1:6379/3), mirroring ERP's convention. ---
