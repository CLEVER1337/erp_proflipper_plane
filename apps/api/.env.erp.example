# Plane API — ERP deploy template (api-only, no worker/beat/rabbitmq/minio).
# Real values are injected via `-e` on `docker run` (like the other ERP services),
# not committed. Container runs with --network host.

DEBUG=0
SECRET_KEY="<set-a-strong-secret>"
WEB_URL="http://localhost:8000"
CORS_ALLOWED_ORIGINS="http://localhost:3000"
GUNICORN_WORKERS=2
PORT=8000

# --- Database: shared ERP Postgres, dedicated DB `erp_plane` (create it first) ---
POSTGRES_HOST="91.239.207.231"
POSTGRES_PORT=18591
POSTGRES_USER="acrelis"
POSTGRES_PASSWORD="<erp-pg-password>"
POSTGRES_DB="erp_plane"
DATABASE_URL="postgresql://acrelis:<erp-pg-password>@91.239.207.231:18591/erp_plane"

# --- Redis: reuse the existing ERP Redis (used by UserService for ERP_user:*). ---
# Use a dedicated DB index (e.g. /3) to avoid key collisions. Cache only, NOT a broker.
REDIS_URL="redis://<erp-redis-host>:6379/3"

# --- Celery: no broker/worker. Run tasks synchronously in-process. ---
CELERY_TASK_ALWAYS_EAGER=1

# --- File storage: DISABLED. Attachments live in ERP (Postgres bytea). ---
# Leave S3 endpoint empty so storage.py runs without a boto client.
USE_MINIO=0
AWS_S3_ENDPOINT_URL=""

API_KEY_RATE_LIMIT="60/minute"
