# Plane API — SECRETS via env (НЕ коммитить). Несекретный конфиг — в закоммиченном
# apps/api/erp_config.json (грузится settings/common.py). Реальный env перекрывает json.
#
# Запуск (секреты — через --env-file, несекретное уже в образе через erp_config.json):
#   docker run -d --name plane-api --network host --restart unless-stopped \
#     --env-file .env  erp-plane-api:latest

# --- DB (общий ERP Postgres, база erp_plane) ---
DB_HOST=91.239.207.231
DB_PORT=18591
DB_USER=acrelis
DB_PASSWORD=<erp-pg-password>
DB_NAME=erp_plane

# --- Секреты ---
SECRET_KEY=<strong-secret>
ERP_GATEWAY_TOKEN=<stable-gateway-token, = leadservice Plane:API_TOKEN>
INTEGRATION_API_KEY=<same-as-erp-IntegrationApiKey>
# (сотрудников bootstrap берёт из UserService GET /users/for-plane — не из env)

# --- Redis (общий инстанс, отдельная logical DB для окружения) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<erp-redis-password>
REDIS_DB=3
